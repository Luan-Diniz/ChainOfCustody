tances xmlns:a="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E671f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>388</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:47:29.9669712-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Evidence Gateway API May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller may be able to remotely execute code for Evidence Gateway API.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Evidence Gateway API exposes strictly typed HTTP REST endpoints that process structured JSON payloads. The service executes static, pre-compiled application logic and does not incorporate dynamic code evaluation (eval), shell command invocation, or unsafe object deserialization based on input from the Holder Interface/Controller, preventing remote code execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E571f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>387</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:46:45.0786413-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API may be able to impersonate the context of Holder Interface/Controller in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The communication flow is unidirectional for command execution: the Holder Interface/Controller initiates requests, and the Evidence Gateway API only provides feedback or responses</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D471f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>386</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:34.3192668-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow HTTP Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D371f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>385</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:30.0501999-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5095bcd7d-71ba-4786-9039-01e1d87bee10004e6504-6c56-4966-968f-c699ba39351f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>095bcd7d-71ba-4786-9039-01e1d87bee10</b:FlowGuid><b:Id>335</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:095bcd7d-71ba-4786-9039-01e1d87bee10:004e6504-6c56-4966-968f-c699ba39351f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:30:15.4287097-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Excessive Resource Consumption for Evidence Gateway API or Off Chain Storage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Evidence Gateway API or Off Chain Storage take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Storage - Gateway Flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>004e6504-6c56-4966-968f-c699ba39351f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5095bcd7d-71ba-4786-9039-01e1d87bee10004e6504-6c56-4966-968f-c699ba39351f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>095bcd7d-71ba-4786-9039-01e1d87bee10</b:FlowGuid><b:Id>334</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:095bcd7d-71ba-4786-9039-01e1d87bee10:004e6504-6c56-4966-968f-c699ba39351f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:19:34.4877176-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Destination Data Store Off Chain Storage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Off Chain Storage may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Off Chain Storage. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Off-Chain Storage database and Evidence Gateway API reside within the same controlled local/internal trust boundary. External attackers cannot spoof or intercept internal host resolution or socket connections between these internal services.&#xD;
&#xD;
For production, the Off Chain Storage should, indeed, be authenticated to prevent spoofing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Storage - Gateway Flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>004e6504-6c56-4966-968f-c699ba39351f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T46c1a9dad-8b8d-49aa-804c-bb28af9cefc511c117b3-8605-44d5-9adb-6f219003ec6e2e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>11c117b3-8605-44d5-9adb-6f219003ec6e</b:FlowGuid><b:Id>465</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:11c117b3-8605-44d5-9adb-6f219003ec6e:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:51:55.3141474-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Collision Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Attackers who can send a series of packets or messages may be able to overlap data. For example, packet 1 may be 100 bytes starting at offset 0. Packet 2 may be 100 bytes starting at offset 25. Packet 2 will overwrite 75 bytes of packet 1. Ensure you reassemble data before filtering it, and ensure you explicitly handle these sorts of cases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>DIDComm: Any malicious overlapping or tampering of packet data in transit will corrupt the payload, causing the Cloud Agent's cryptographic decryption and signature verification checks to fail, which results in the immediate rejection of the message.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>DIDComm</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T36c1a9dad-8b8d-49aa-804c-bb28af9cefc511c117b3-8605-44d5-9adb-6f219003ec6e2e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>11c117b3-8605-44d5-9adb-6f219003ec6e</b:FlowGuid><b:Id>464</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:11c117b3-8605-44d5-9adb-6f219003ec6e:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:53:55.3512297-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Packets or messages without sequence numbers or timestamps can be captured and replayed in a wide variety of ways. Implement or utilize an existing communication protocol that supports anti-replay techniques (investigate sequence numbers before timers) and strong integrity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>DIDComm utilizes envelopes that inherently include cryptographic timestamps, unique message IDs, and nonces. This protocol-level design prevents captured messages from being successfully replayed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>DIDComm</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T46c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>463</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T12:02:15.5688657-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Collision Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Attackers who can send a series of packets or messages may be able to overlap data. For example, packet 1 may be 100 bytes starting at offset 0. Packet 2 may be 100 bytes starting at offset 25. Packet 2 will overwrite 75 bytes of packet 1. Ensure you reassemble data before filtering it, and ensure you explicitly handle these sorts of cases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Network-level packet fragmentation and reassembly are managed safely by the underlying Docker virtual network stack and the host OS kernel. Any maliciously overlapping TCP segments are dropped at the transport layer before reaching the application's HTTP framework. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T36c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>462</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:53:14.2462805-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Packets or messages without sequence numbers or timestamps can be captured and replayed in a wide variety of ways. Implement or utilize an existing communication protocol that supports anti-replay techniques (investigate sequence numbers before timers) and strong integrity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Current local development over unencrypted HTTP lacks native replay protection. Production deployments must enforce HTTPS (TLS) alongside short-lived API tokens or request nonces to prevent captured HTTP payloads from being replayed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T46c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>459</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T12:02:07.4050885-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Collision Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Attackers who can send a series of packets or messages may be able to overlap data. For example, packet 1 may be 100 bytes starting at offset 0. Packet 2 may be 100 bytes starting at offset 25. Packet 2 will overwrite 75 bytes of packet 1. Ensure you reassemble data before filtering it, and ensure you explicitly handle these sorts of cases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Network-level packet fragmentation and reassembly are managed safely by the underlying Docker virtual network stack and the host OS kernel. Any maliciously overlapping TCP segments are dropped at the transport layer before reaching the application's HTTP framework. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T36c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>458</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:53:05.6644599-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Packets or messages without sequence numbers or timestamps can be captured and replayed in a wide variety of ways. Implement or utilize an existing communication protocol that supports anti-replay techniques (investigate sequence numbers before timers) and strong integrity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Current local development over unencrypted HTTP lacks native replay protection. Production deployments must enforce HTTPS (TLS) alongside short-lived API tokens or request nonces to prevent captured HTTP payloads from being replayed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T42e28b743-dcab-4fb7-8a07-50d24d00b023692ca193-0dc2-478e-93f2-64f5f64281b46c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>692ca193-0dc2-478e-93f2-64f5f64281b4</b:FlowGuid><b:Id>457</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:692ca193-0dc2-478e-93f2-64f5f64281b4:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:52:13.4510254-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Collision Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Attackers who can send a series of packets or messages may be able to overlap data. For example, packet 1 may be 100 bytes starting at offset 0. Packet 2 may be 100 bytes starting at offset 25. Packet 2 will overwrite 75 bytes of packet 1. Ensure you reassemble data before filtering it, and ensure you explicitly handle these sorts of cases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>DIDComm: Any malicious overlapping or tampering of packet data in transit will corrupt the payload, causing the Cloud Agent's cryptographic decryption and signature verification checks to fail, which results in the immediate rejection of the message.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>DIDComm</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T32e28b743-dcab-4fb7-8a07-50d24d00b023692ca193-0dc2-478e-93f2-64f5f64281b46c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>692ca193-0dc2-478e-93f2-64f5f64281b4</b:FlowGuid><b:Id>456</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:692ca193-0dc2-478e-93f2-64f5f64281b4:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:54:08.0785723-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Packets or messages without sequence numbers or timestamps can be captured and replayed in a wide variety of ways. Implement or utilize an existing communication protocol that supports anti-replay techniques (investigate sequence numbers before timers) and strong integrity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>DIDComm utilizes envelopes that inherently include cryptographic timestamps, unique message IDs, and nonces. This protocol-level design prevents captured messages from being successfully replayed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>DIDComm</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E66c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>409</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:57:29.6053504-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Evidence Gateway API May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent may be able to remotely execute code for Evidence Gateway API.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The HTTP REST endpoints across the components currently lack comprehensive input sanitization and strict payload boundary checks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E56c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>408</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:55:07.352586-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API may be able to impersonate the context of Issuer/Verifier Cloud Agent in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Evidence Gateway API and Issuer/Verifier Cloud Agent operate as separate microservices in isolated Docker containers. They interact via restricted REST endpoints and do not support security context delegation or share administrative session state</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D46c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>407</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:54.0957925-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow HTTP Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D36c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>406</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:50.1367695-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I66c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>405</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:34:25.3977474-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R66c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>404</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:11:43.51412-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Operations are anchored to an immutable blockchain ledger containing cryptographic timestamps and DID signatures. This provides an immutable, tamper-proof record of transactions, making audits possible and enforcing non-repudiation of received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.16c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>403</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:35:47.9026017-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Evidence Gateway API' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>No HTML or DOM is used in this context</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T16c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>402</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:39:16.8766511-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be tampered with by an attacker. This may lead to a denial of service attack against Evidence Gateway API or an elevation of privilege attack against Evidence Gateway API or an information disclosure by Evidence Gateway API. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S26c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>401</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:22:26.8468642-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Evidence Gateway API Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API may be spoofed by an attacker and this may lead to information disclosure by Issuer/Verifier Cloud Agent. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The communication currently uses unencrypted HTTP endpoints or local Docker networking. API Key authentication and HTTPS with TLS certificate validation must be verified and enforced prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T42e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>453</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T12:02:00.8807457-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Collision Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Attackers who can send a series of packets or messages may be able to overlap data. For example, packet 1 may be 100 bytes starting at offset 0. Packet 2 may be 100 bytes starting at offset 25. Packet 2 will overwrite 75 bytes of packet 1. Ensure you reassemble data before filtering it, and ensure you explicitly handle these sorts of cases.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Network-level packet fragmentation and reassembly are managed safely by the underlying Docker virtual network stack and the host OS kernel. Any maliciously overlapping TCP segments are dropped at the transport layer before reaching the application's HTTP framework. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>8404dcf5-bdd8-4902-abc2-3b6c967b02617c5dfb1e-9f9c-421e-ac50-a846f335dbbb56b29de7-7782-43b7-80f2-208c80d1ef4ef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>56b29de7-7782-43b7-80f2-208c80d1ef4e</b:FlowGuid><b:Id>311</b:Id><b:InteractionKey>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb:56b29de7-7782-43b7-80f2-208c80d1ef4e:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:10:15.9517106-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Request Forgery</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Cross-site request forgery (CSRF or XSRF) is a type of attack in which an attacker forces a user's browser to make a forged request to a vulnerable site by exploiting an existing trust relationship between the browser and the vulnerable web site.  In a simple scenario, a user is logged in to web site A using a cookie as a credential.  The other browses to web site B.  Web site B returns a page with a hidden form that posts to web site A.  Since the browser will carry the user's cookie to web site A, web site B now can take any action on web site A, for example, adding an admin to an account.  The attack can be used to exploit any requests that the browser automatically authenticates, e.g. by session cookie, integrated authentication, IP whitelisting. The attack can be carried out in many ways such as by luring the victim to a site under control of the attacker, getting the user to click a link in a phishing email, or hacking a reputable web site that the victim will visit. The issue can only be resolved on the server side by requiring that all authenticated state-changing requests include an additional piece of secret payload (canary or CSRF token) which is known only to the legitimate web site and the browser and which is protected in transit through SSL/TLS. See the Forgery Protection property on the flow stencil for a list of mitigations.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>No browser in this context.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>8404dcf5-bdd8-4902-abc2-3b6c967b0261</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E77c5dfb1e-9f9c-421e-ac50-a846f335dbbb56b29de7-7782-43b7-80f2-208c80d1ef4ef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>56b29de7-7782-43b7-80f2-208c80d1ef4e</b:FlowGuid><b:Id>310</b:Id><b:InteractionKey>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb:56b29de7-7782-43b7-80f2-208c80d1ef4e:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:12:31.603821-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Evidence Gateway API in order to change the flow of program execution within Evidence Gateway API to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Hyperledger Fabric chaincode executes exclusively within isolated containerized environments managed directly by Fabric Peer nodes. The Evidence Gateway API acts strictly as an external client submitting gRPC transaction proposals</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E67c5dfb1e-9f9c-421e-ac50-a846f335dbbb56b29de7-7782-43b7-80f2-208c80d1ef4ef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>56b29de7-7782-43b7-80f2-208c80d1ef4e</b:FlowGuid><b:Id>309</b:Id><b:InteractionKey>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb:56b29de7-7782-43b7-80f2-208c80d1ef4e:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:12:04.4466758-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Evidence Gateway API May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Fabric Chaincode may be able to remotely execute code for Evidence Gateway API.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Hyperledger Fabric chaincode executes exclusively within isolated containerized environments managed directly by Fabric Peer nodes. The chaincode were evaluated and approved beforehand by the nodes composing the Fabric blockchain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E57c5dfb1e-9f9c-421e-ac50-a846f335dbbb56b29de7-7782-43b7-80f2-208c80d1ef4ef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>56b29de7-7782-43b7-80f2-208c80d1ef4e</b:FlowGuid><b:Id>308</b:Id><b:InteractionKey>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb:56b29de7-7782-43b7-80f2-208c80d1ef4e:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:11:09.0024659-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API may be able to impersonate the context of Fabric Chaincode in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Hyperledger Fabric chaincode executes exclusively within isolated containerized environments managed directly by Fabric Peer nodes. The Evidence Gateway API acts strictly as an external client submitting gRPC transaction proposals</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T12f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>467</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:48:24.707824-03:00</b:ModifiedAt><b:Priority>Medium</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>JavaScript Object Notation Processing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If a dataflow contains JSON, JSON processing and hijacking threats may be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>This item remains a residual risk that requires further verification or clarification on how the Cloud Agent processes JSON</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T126c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>466</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:50:43.5310156-03:00</b:ModifiedAt><b:Priority>Medium</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>JavaScript Object Notation Processing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>If a dataflow contains JSON, JSON processing and hijacking threats may be exploited.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>For production, a safe JSON processing should be implemented</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T12</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2671f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>443</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:13:41.0872609-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Holder is authenticated by its AnonCreds credential, which Evidence Gateway API validates it in the Identus environment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E76c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>410</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:58:46.4742347-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Evidence Gateway API in order to change the flow of program execution within Evidence Gateway API to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The custom-built Evidence Gateway API currently lack strict input validation and payload schema checks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>399</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:58:25.2493796-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Holder Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Holder Interface/Controller in order to change the flow of program execution within Holder Interface/Controller to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The custom-built Holder Interface/Controller and Evidence Gateway API currently lack strict input validation and payload schema checks.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>398</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:57:21.1966827-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Holder Interface/Controller May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API may be able to remotely execute code for Holder Interface/Controller.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The HTTP REST endpoints across the components currently lack comprehensive input sanitization and strict payload boundary checks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>397</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:49:28.0904615-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller may be able to impersonate the context of Evidence Gateway API in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Holder Interface/Controller and Evidence Gateway API run as isolated microservices in separate Docker containers. The Holder Interface operates strictly as an external client invoking exposed endpoints on the Evidence Gateway API. The architecture does not employ security context delegation or shared execution tokens between these services, preventing the Holder Interface from impersonating the Gateway API or assuming its identity and privileges within the system.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>396</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:46.8775014-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow HTTP Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>395</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:42.8505865-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Holder Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>420</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:58:00.1115696-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Issuer/Verifier Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Issuer/Verifier Cloud Agent in order to change the flow of program execution within Issuer/Verifier Cloud Agent to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Although the Cloud Agent utilizes OpenAPI schemas, the deployment's specific environment configurations and custom routing rules have not been fully audited for strict payload sanitization</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>419</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:57:38.3494775-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Issuer/Verifier Cloud Agent May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API may be able to remotely execute code for Issuer/Verifier Cloud Agent.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The HTTP REST endpoints across the components currently lack comprehensive input sanitization and strict payload boundary checks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>418</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:55:18.6396255-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent may be able to impersonate the context of Evidence Gateway API in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Evidence Gateway API and Issuer/Verifier Cloud Agent operate as separate microservices in isolated Docker containers. They interact via restricted REST endpoints and do not support security context delegation or share administrative session state</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>417</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:25:04.5185794-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow HTTP Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>416</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:25:00.9563986-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Issuer/Verifier Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>415</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:34:29.7176817-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>414</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:12:02.2726943-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Issuer/Verifier Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Operations are anchored to an immutable blockchain ledger (Fabric) containing cryptographic timestamps and DID signatures. This provides an immutable, tamper-proof record of transactions, making audits possible and enforcing non-repudiation of received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>413</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:39:20.5511886-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Issuer/Verifier Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be tampered with by an attacker. This may lead to a denial of service attack against Issuer/Verifier Cloud Agent or an elevation of privilege attack against Issuer/Verifier Cloud Agent or an information disclosure by Issuer/Verifier Cloud Agent. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>412</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:22:32.1617762-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Issuer/Verifier Cloud Agent Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent may be spoofed by an attacker and this may lead to information disclosure by Evidence Gateway API. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The communication currently uses unencrypted HTTP endpoints or local Docker networking. API Key authentication and HTTPS with TLS certificate validation must be verified and enforced prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E771f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>389</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:48:43.8129387-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Evidence Gateway API in order to change the flow of program execution within Evidence Gateway API to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Evidence Gateway API currently lacks explicit schema validation and input sanitization on incoming request payloads</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E72e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>378</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:39:01.3703537-03:00</b:ModifiedAt><b:Priority>Medium</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Holder Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Holder Interface/Controller in order to change the flow of program execution within Holder Interface/Controller to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Holder Interface/Controller currently lacks strict input validation and schema checking on incoming HTTP payloads</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E62e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>377</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:36:43.0841581-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Holder Interface/Controller May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Cloud Agent may be able to remotely execute code for Holder Interface/Controller.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Holder Cloud Agent acts as a service managed by the Holder Interface/Controller and does not initiate administrative requests to assume the Controller's execution or user session context. Webhook notifications sent by the Cloud Agent to the Controller are processed strictly as event-driven state updates, preventing the Cloud Agent from executing privileged operations on behalf of the Controller.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E52e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>376</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:39:49.2055693-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller may be able to impersonate the context of Holder Cloud Agent in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Cloud Agent acts as a service managed by the Interface/Controller and does not initiate administrative requests to assume the Controller's execution or user session context. Webhook notifications sent by the Cloud Agent to the Controller are processed strictly as event-driven state updates, preventing the Cloud Agent from executing privileged operations on behalf of the Controller.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D42e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>375</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:25.8773133-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow HTTP Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D32e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>374</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:22.0923084-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Holder Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I62e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>373</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:34:01.0303373-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R62e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>372</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:13:13.0461026-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Holder Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Incoming request payloads received by the Interface/Controller are cryptographically signed using the sender's DID private key, verifying origin and authenticity. Furthermore, state transitions and issuance events are anchored to the blockchain ledger with immutable block timestamps, providing a permanent audit trail that proves data receipt and prevents repudiation.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T12e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>371</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:38:47.0216761-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Holder Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be tampered with by an attacker. This may lead to a denial of service attack against Holder Interface/Controller or an elevation of privilege attack against Holder Interface/Controller or an information disclosure by Holder Interface/Controller. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S22e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>370</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:21:53.0299147-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Holder Interface/Controller Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller may be spoofed by an attacker and this may lead to information disclosure by Holder Cloud Agent. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The communication currently uses unencrypted HTTP endpoints or local Docker networking. API Key authentication and HTTPS with TLS certificate validation must be verified and enforced prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I266c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>448</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:07:12.9178946-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S271f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>360</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:21:44.9826223-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Holder Cloud Agent Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Cloud Agent may be spoofed by an attacker and this may lead to information disclosure by Holder Interface/Controller. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The communication currently uses unencrypted HTTP endpoints or local Docker networking. API Key authentication and HTTPS with TLS certificate validation must be verified and enforced prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E76c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>358</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:38:06.6756406-03:00</b:ModifiedAt><b:Priority>Medium</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Issuer Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Issuer Interface/Controller in order to change the flow of program execution within Issuer Interface/Controller to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Issuer Interface/Controller currently lacks strict input validation and schema checking on incoming HTTP payloads</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E66c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>357</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:32:56.1846887-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Issuer Interface/Controller May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent may be able to remotely execute code for Issuer Interface/Controller.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Communication between the Interface/Controller and Cloud Agent occurs exclusively over strongly typed REST API endpoints with strict JSON schema validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I671f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>384</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:34:12.719053-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R671f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>383</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:11:00.4403052-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Operations are anchored to an immutable blockchain ledger (Fabric) containing cryptographic timestamps and DID signatures. This provides an immutable, tamper-proof record of transactions, making audits possible and enforcing non-repudiation of received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.171f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>382</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:35:40.3994489-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Evidence Gateway API' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>No HTML or DOM is used in this context</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T171f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>381</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:38:52.238344-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be tampered with by an attacker. This may lead to a denial of service attack against Evidence Gateway API or an elevation of privilege attack against Evidence Gateway API or an information disclosure by Evidence Gateway API. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S271f6bb06-a5ee-4154-b144-28316d5c6248d57a4244-52b1-40e2-8aa5-724626d0c989f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>d57a4244-52b1-40e2-8aa5-724626d0c989</b:FlowGuid><b:Id>380</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:d57a4244-52b1-40e2-8aa5-724626d0c989:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:22:04.2496587-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Evidence Gateway API Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API may be spoofed by an attacker and this may lead to information disclosure by Holder Interface/Controller. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The communication currently uses unencrypted HTTP endpoints or local Docker networking. API Key authentication and HTTPS with TLS certificate validation must be verified and enforced prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2672db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>444</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:05:09.3201737-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>394</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:34:18.517835-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>393</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:11:22.0628761-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Holder Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Operations are anchored to an immutable blockchain ledger (Fabric) containing cryptographic timestamps and DID signatures. This provides an immutable, tamper-proof record of transactions, making audits possible and enforcing non-repudiation of received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T1f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>392</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:39:11.2545107-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Holder Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be tampered with by an attacker. This may lead to a denial of service attack against Holder Interface/Controller or an elevation of privilege attack against Holder Interface/Controller or an information disclosure by Holder Interface/Controller. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S2f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>391</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:22:10.3956894-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Holder Interface/Controller Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller may be spoofed by an attacker and this may lead to information disclosure by Evidence Gateway API. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The communication currently uses unencrypted HTTP endpoints or local Docker networking. API Key authentication and HTTPS with TLS certificate validation must be verified and enforced prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5095bcd7d-71ba-4786-9039-01e1d87bee10004e6504-6c56-4966-968f-c699ba39351f</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>095bcd7d-71ba-4786-9039-01e1d87bee10</b:FlowGuid><b:Id>436</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:095bcd7d-71ba-4786-9039-01e1d87bee10:004e6504-6c56-4966-968f-c699ba39351f</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:00:03.0916072-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Authorization Bypass</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Can you access Off Chain Storage and bypass the permissions for the object? For example by editing the files directly with a hex editor, or reaching it via filesharing? Ensure that your program is the only one that can access the data, and that all other subjects have to use your interface.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>This Storage should run in a container and only be acessible via requests.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Storage - Gateway Flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>004e6504-6c56-4966-968f-c699ba39351f</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E56c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>356</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:31:58.9741787-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer Interface/Controller may be able to impersonate the context of Issuer/Verifier Cloud Agent in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Cloud Agent acts as a service managed by the Interface/Controller and does not initiate administrative requests to assume the Controller's execution or user session context. Webhook notifications sent by the Cloud Agent to the Controller are processed strictly as event-driven state updates, preventing the Cloud Agent from executing privileged operations on behalf of the Controller.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D46c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>355</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:07.3608951-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow HTTP Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D36c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>354</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:02.6360273-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Issuer Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer Interface/Controller crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I66c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>353</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:33:44.1710418-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R66c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>352</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:13:03.9987974-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Issuer Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer Interface/Controller claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Incoming request payloads received by the Interface/Controller are cryptographically signed using the sender's DID private key, verifying origin and authenticity. Furthermore, state transitions and issuance events are anchored to the blockchain ledger with immutable block timestamps, providing a permanent audit trail that proves data receipt and prevents repudiation.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T16c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>351</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:38:37.9387522-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Issuer Interface/Controller</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be tampered with by an attacker. This may lead to a denial of service attack against Issuer Interface/Controller or an elevation of privilege attack against Issuer Interface/Controller or an information disclosure by Issuer Interface/Controller. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S26c1a9dad-8b8d-49aa-804c-bb28af9cefc5041eb2c8-ef3f-4110-baa5-eb92510e4a9772db45cc-0141-4130-9e67-d0d200ec69af</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>041eb2c8-ef3f-4110-baa5-eb92510e4a97</b:FlowGuid><b:Id>350</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:041eb2c8-ef3f-4110-baa5-eb92510e4a97:72db45cc-0141-4130-9e67-d0d200ec69af</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:21:31.4918954-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Issuer Interface/Controller Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer Interface/Controller may be spoofed by an attacker and this may lead to information disclosure by Issuer/Verifier Cloud Agent. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The communication currently uses unencrypted HTTP endpoints or local Docker networking. API Key authentication and HTTPS with TLS certificate validation must be verified and enforced prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T32e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>452</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:52:30.8808059-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Replay Attacks</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Packets or messages without sequence numbers or timestamps can be captured and replayed in a wide variety of ways. Implement or utilize an existing communication protocol that supports anti-replay techniques (investigate sequence numbers before timers) and strong integrity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Current local development over unencrypted HTTP lacks native replay protection. Production deployments must enforce HTTPS (TLS) alongside short-lived API tokens or request nonces to prevent captured HTTP payloads from being replayed.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E772db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>348</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:31:05.8998591-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Issuer/Verifier Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Issuer/Verifier Cloud Agent in order to change the flow of program execution within Issuer/Verifier Cloud Agent to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Communication between the Interface/Controller and Cloud Agent occurs exclusively over strongly typed REST API endpoints with strict JSON schema validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E672db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>347</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:30:11.8634689-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Issuer/Verifier Cloud Agent May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer Interface/Controller may be able to remotely execute code for Issuer/Verifier Cloud Agent.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Communication between the Interface/Controller and Cloud Agent occurs exclusively over strongly typed REST API endpoints with strict JSON schema validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E572db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>346</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:26:06.6476719-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent may be able to impersonate the context of Issuer Interface/Controller in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Issuer/Verifier Cloud Agent acts as a service managed by the Issuer Interface/Controller and does not initiate administrative requests to assume the Controller's execution or user session context. Webhook notifications sent by the Cloud Agent to the Controller are processed strictly as event-driven state updates, preventing the Cloud Agent from executing privileged operations on behalf of the Controller.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D472db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>345</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:23:58.4623499-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow HTTP Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D372db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>344</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:23:53.0193761-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Issuer/Verifier Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I672db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>343</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:33:21.7503279-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R672db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>342</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:10:04.9216436-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Issuer/Verifier Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>State transitions and key operations handled by the Issuer/Verifier Cloud Agent are anchored to an immutable blockchain ledger containing cryptographic timestamps and DID signatures. This provides an immutable, tamper-proof record of transactions, making audits possible and enforcing non-repudiation of received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T172db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>341</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:38:27.4066072-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Issuer/Verifier Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be tampered with by an attacker. This may lead to a denial of service attack against Issuer/Verifier Cloud Agent or an elevation of privilege attack against Issuer/Verifier Cloud Agent or an information disclosure by Issuer/Verifier Cloud Agent. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S272db45cc-0141-4130-9e67-d0d200ec69afb53cee9a-65dc-4222-9a55-8d0348fbbb4c6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>b53cee9a-65dc-4222-9a55-8d0348fbbb4c</b:FlowGuid><b:Id>340</b:Id><b:InteractionKey>72db45cc-0141-4130-9e67-d0d200ec69af:b53cee9a-65dc-4222-9a55-8d0348fbbb4c:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:20:40.9311976-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing the Issuer/Verifier Cloud Agent Process</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent may be spoofed by an attacker and this may lead to information disclosure by Issuer Interface/Controller. Consider using a standard authentication mechanism to identify the destination process.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The communication currently uses unencrypted HTTP endpoints or local Docker networking. API Key authentication and HTTPS with TLS certificate validation must be verified and enforced prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>72db45cc-0141-4130-9e67-d0d200ec69af</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I262e28b743-dcab-4fb7-8a07-50d24d00b0237af6213d-445c-405f-a4f7-78d98beb146571f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>7af6213d-445c-405f-a4f7-78d98beb1465</b:FlowGuid><b:Id>445</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:7af6213d-445c-405f-a4f7-78d98beb1465:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:05:21.010225-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E59fb41275-1253-4763-8b8f-9fd07e0ffe54f900d8a5-6675-4535-a20d-89bcd6a2ad1871f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>f900d8a5-6675-4535-a20d-89bcd6a2ad18</b:FlowGuid><b:Id>204</b:Id><b:InteractionKey>9fb41275-1253-4763-8b8f-9fd07e0ffe54:f900d8a5-6675-4535-a20d-89bcd6a2ad18:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:01:01.456332-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller may be able to impersonate the context of Forensic Expert in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Holder cannot arbitrarily elevate privileges because authorization is enforced by the Gateway using verified AnonCreds ZKP predicates.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Command Line Interface</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>9fb41275-1253-4763-8b8f-9fd07e0ffe54</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I266c1a9dad-8b8d-49aa-804c-bb28af9cefc5a0609599-cd9a-410c-8a2c-911eee9fe340f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>a0609599-cd9a-410c-8a2c-911eee9fe340</b:FlowGuid><b:Id>450</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:a0609599-cd9a-410c-8a2c-911eee9fe340:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:07:21.353338-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I266c1a9dad-8b8d-49aa-804c-bb28af9cefc511c117b3-8605-44d5-9adb-6f219003ec6e2e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>11c117b3-8605-44d5-9adb-6f219003ec6e</b:FlowGuid><b:Id>451</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:11c117b3-8605-44d5-9adb-6f219003ec6e:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:06:43.7359719-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>DIDComm does not use a custom authentication scheme. Authentication between agents relies on open standardized specifications using public-key cryptography bound to Decentralized Identifiers (DIDs).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>DIDComm</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E771f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>368</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:28:40.4235487-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Holder Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Holder Cloud Agent in order to change the flow of program execution within Holder Cloud Agent to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Holder Cloud Agent validates all incoming REST API payloads and DIDComm messages against strictly defined JSON schemas and strongly typed data models before execution.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E671f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>367</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:29:44.5528739-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Holder Cloud Agent May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Interface/Controller may be able to remotely execute code for Holder Cloud Agent.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Communication between the Holder Interface/Controller and Holder Cloud Agent occurs exclusively over strongly typed REST API endpoints with strict JSON schema validation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E571f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>366</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:35:16.9639922-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Cloud Agent may be able to impersonate the context of Holder Interface/Controller in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Holder Cloud Agent operates strictly as a managed backend service to handle DIDComm protocols and credential lifecycle states. Webhook notifications sent back to the Controller are passive event updates that do not accept or grant privileged execution capabilities.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D471f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>365</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:18.016671-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow HTTP Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D371f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>364</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:24:12.8097441-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Holder Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Cloud Agent crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I671f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>363</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:33:56.9217514-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R671f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>362</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:10:20.4548193-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Holder Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Cloud Agent claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>State transitions and key operations handled by the Issuer/Verifier Cloud Agent are anchored to an immutable blockchain ledger containing cryptographic timestamps and DID signatures. This provides an immutable, tamper-proof record of transactions, making audits possible and enforcing non-repudiation of received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T171f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>361</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:38:43.2052969-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Lack of Input Validation for Holder Cloud Agent</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across HTTP may be tampered with by an attacker. This may lead to a denial of service attack against Holder Cloud Agent or an elevation of privilege attack against Holder Cloud Agent or an information disclosure by Holder Cloud Agent. Failure to verify that input is as expected is a root cause of a very large number of exploitable issues. Consider all paths and the way they handle data. Verify that all input is verified for correctness using an approved list input validation approach.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS should be used in production</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D47c5dfb1e-9f9c-421e-ac50-a846f335dbbb56b29de7-7782-43b7-80f2-208c80d1ef4ef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>56b29de7-7782-43b7-80f2-208c80d1ef4e</b:FlowGuid><b:Id>307</b:Id><b:InteractionKey>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb:56b29de7-7782-43b7-80f2-208c80d1ef4e:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:30:04.0836125-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Fabric Gateway (gRPC) Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D37c5dfb1e-9f9c-421e-ac50-a846f335dbbb56b29de7-7782-43b7-80f2-208c80d1ef4ef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>56b29de7-7782-43b7-80f2-208c80d1ef4e</b:FlowGuid><b:Id>306</b:Id><b:InteractionKey>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb:56b29de7-7782-43b7-80f2-208c80d1ef4e:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:30:00.0765266-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I26f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f512cfb972-d637-4aa4-bdb2-e5210738dc6e6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>12cfb972-d637-4aa4-bdb2-e5210738dc6e</b:FlowGuid><b:Id>441</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:12cfb972-d637-4aa4-bdb2-e5210738dc6e:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:59:40.4129628-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The HTTP endpoints currently lack any authentication mechanisms, such as API keys or tokens. Requires the implementation of a standard authentication protocol prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R67c5dfb1e-9f9c-421e-ac50-a846f335dbbb56b29de7-7782-43b7-80f2-208c80d1ef4ef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>56b29de7-7782-43b7-80f2-208c80d1ef4e</b:FlowGuid><b:Id>304</b:Id><b:InteractionKey>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb:56b29de7-7782-43b7-80f2-208c80d1ef4e:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:09:01.3642871-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Evidence Gateway API</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Operations are registered at Hyperledger's Fabric blockchain (with timestamp). Auditions are possible.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.17c5dfb1e-9f9c-421e-ac50-a846f335dbbb56b29de7-7782-43b7-80f2-208c80d1ef4ef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>56b29de7-7782-43b7-80f2-208c80d1ef4e</b:FlowGuid><b:Id>303</b:Id><b:InteractionKey>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb:56b29de7-7782-43b7-80f2-208c80d1ef4e:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:04:56.8419067-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Evidence Gateway API' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>No HTML or DOM in this context.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I26f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f516bba22e-3399-4d8c-ae5f-83ac68d8755d71f6bb06-a5ee-4154-b144-28316d5c6248</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>16bba22e-3399-4d8c-ae5f-83ac68d8755d</b:FlowGuid><b:Id>440</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:16bba22e-3399-4d8c-ae5f-83ac68d8755d:71f6bb06-a5ee-4154-b144-28316d5c6248</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:03:33.6028484-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>HTTPS Should be used in production, authenticating Evidence Gateway API.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I267c5dfb1e-9f9c-421e-ac50-a846f335dbbb56b29de7-7782-43b7-80f2-208c80d1ef4ef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>56b29de7-7782-43b7-80f2-208c80d1ef4e</b:FlowGuid><b:Id>430</b:Id><b:InteractionKey>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb:56b29de7-7782-43b7-80f2-208c80d1ef4e:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:00:51.4602195-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>In production, it is needed to elaborate the on how to authenticate the Fabric nodes.  (Authentication between the Fabric Gateway, peers, and chaincode is handled natively using an industry-standard Membership Service Provider (MSP) and X.509 certificates issued by a trusted Certificate Authority (CA) by default)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E7f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f538426204-7f98-4440-b7d0-81660bbb18777c5dfb1e-9f9c-421e-ac50-a846f335dbbb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>38426204-7f98-4440-b7d0-81660bbb1877</b:FlowGuid><b:Id>299</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:38426204-7f98-4440-b7d0-81660bbb1877:7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:06:48.2945484-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation by Changing the Execution Flow in Fabric Chaincode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An attacker may pass data into Fabric Chaincode in order to change the flow of program execution within Fabric Chaincode to the attacker's choosing.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Input parameters passed into chaincode routines are strictly validated and type-checked against expected schemas before processing. &#xD;
Smart contract logic follows predefined, deterministic control flows with no dynamic code execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E6f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f538426204-7f98-4440-b7d0-81660bbb18777c5dfb1e-9f9c-421e-ac50-a846f335dbbb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>38426204-7f98-4440-b7d0-81660bbb1877</b:FlowGuid><b:Id>298</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:38426204-7f98-4440-b7d0-81660bbb1877:7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:00:40.0609316-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Fabric Chaincode May be Subject to Elevation of Privilege Using Remote Code Execution</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Evidence Gateway API may be able to remotely execute code for Fabric Chaincode.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The Evidence Gateway API interacts with the Fabric network strictly via gRPC transaction proposals targeting exposed smart contract functions. Hyperledger Fabric requires all chaincode to be pre-compiled, statically defined, and cryptographically approved by channel administrators prior to deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f538426204-7f98-4440-b7d0-81660bbb18777c5dfb1e-9f9c-421e-ac50-a846f335dbbb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>38426204-7f98-4440-b7d0-81660bbb1877</b:FlowGuid><b:Id>297</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:38426204-7f98-4440-b7d0-81660bbb1877:7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:00:16.5403139-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Fabric Chaincode may be able to impersonate the context of Evidence Gateway API in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Hyperledger Fabric chaincode executes reactively within an isolated environment (Docker container) on the Peer node. It strictly processes incoming transaction proposals.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D4f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f538426204-7f98-4440-b7d0-81660bbb18777c5dfb1e-9f9c-421e-ac50-a846f335dbbb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>38426204-7f98-4440-b7d0-81660bbb1877</b:FlowGuid><b:Id>296</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:38426204-7f98-4440-b7d0-81660bbb1877:7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:00:47.8832294-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Fabric Gateway (gRPC) Is Potentially Interrupted</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external agent interrupts data flowing across a trust boundary in either direction.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D4</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D3f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f538426204-7f98-4440-b7d0-81660bbb18777c5dfb1e-9f9c-421e-ac50-a846f335dbbb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>38426204-7f98-4440-b7d0-81660bbb1877</b:FlowGuid><b:Id>295</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:38426204-7f98-4440-b7d0-81660bbb1877:7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:24:56.6275763-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Process Crash or Stop for Fabric Chaincode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Fabric Chaincode crashes, halts, stops or runs slowly; in all cases violating an availability metric.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Strategies to mitigate DDoS should be investigated.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>R6f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f538426204-7f98-4440-b7d0-81660bbb18777c5dfb1e-9f9c-421e-ac50-a846f335dbbb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>38426204-7f98-4440-b7d0-81660bbb1877</b:FlowGuid><b:Id>293</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:38426204-7f98-4440-b7d0-81660bbb1877:7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:30:44.7581591-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Potential Data Repudiation by Fabric Chaincode</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Repudiation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Repudiation threats involve an adversary denying that something happened.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Fabric Chaincode claims that it did not receive data from a source outside the trust boundary. Consider using logging or auditing to record the source, time, and summary of the received data.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Data written to a blockchain is permanent, so they can be audited, specially because theres timestamp metadata stored too. Also, non-repudiation of origin is enforced because the operation payload is cryptographically signed using the expert's DID private key.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>R6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I262e28b743-dcab-4fb7-8a07-50d24d00b023692ca193-0dc2-478e-93f2-64f5f64281b46c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>692ca193-0dc2-478e-93f2-64f5f64281b4</b:FlowGuid><b:Id>447</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:692ca193-0dc2-478e-93f2-64f5f64281b4:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:06:36.3965399-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>DIDComm does not use a custom authentication scheme. Authentication between agents relies on open standardized specifications using public-key cryptography bound to Decentralized Identifiers (DIDs).</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>DIDComm</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I2671f6bb06-a5ee-4154-b144-28316d5c62485223982b-a8b4-415f-abf6-0ac71be268b82e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>5223982b-a8b4-415f-abf6-0ac71be268b8</b:FlowGuid><b:Id>442</b:Id><b:InteractionKey>71f6bb06-a5ee-4154-b144-28316d5c6248:5223982b-a8b4-415f-abf6-0ac71be268b8:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:59:51.7445812-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>The HTTP endpoints currently lack any authentication mechanisms, such as API keys or tokens. Requires the implementation of a standard authentication protocol prior to production deployment.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>HTTP</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>71f6bb06-a5ee-4154-b144-28316d5c6248</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I26f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f538426204-7f98-4440-b7d0-81660bbb18777c5dfb1e-9f9c-421e-ac50-a846f335dbbb</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>38426204-7f98-4440-b7d0-81660bbb1877</b:FlowGuid><b:Id>439</b:Id><b:InteractionKey>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5:38426204-7f98-4440-b7d0-81660bbb1877:7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T11:02:42.6994974-03:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Authentication Scheme</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Custom authentication schemes are susceptible to common weaknesses such as weak credential change management, credential equivalence, easily guessable credentials, null credentials, downgrade authentication or a weak credential change management system. Consider the impact and potential mitigations for your custom authentication scheme.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>In production, it is needed to elaborate the on how to authenticate the Fabric nodes.  (Authentication between the Fabric Gateway, peers, and chaincode is handled natively using an industry-standard Membership Service Provider (MSP) and X.509 certificates issued by a trusted Certificate Authority (CA) by default)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Fabric Gateway (gRPC)</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>High</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:SourceGuid><b:State>NeedsInvestigation</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7c5dfb1e-9f9c-421e-ac50-a846f335dbbb</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I26</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I23004e6504-6c56-4966-968f-c699ba39351f372f04fd-f8e7-4f92-90ff-8f9b077d51fef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>372f04fd-f8e7-4f92-90ff-8f9b077d51fe</b:FlowGuid><b:Id>289</b:Id><b:InteractionKey>004e6504-6c56-4966-968f-c699ba39351f:372f04fd-f8e7-4f92-90ff-8f9b077d51fe:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:16:50.4073153-03:00</b:ModifiedAt><b:Priority>Medium</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Weak Access Control for a Resource</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Improper data protection of Off Chain Storage can allow an attacker to read information not intended for disclosure. Review authorization settings.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>All access is mediated by ZKP Authorization. This DB is not expose to public internet.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Gateway - Storage Flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Medium</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>004e6504-6c56-4966-968f-c699ba39351f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I23</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.2004e6504-6c56-4966-968f-c699ba39351f372f04fd-f8e7-4f92-90ff-8f9b077d51fef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>372f04fd-f8e7-4f92-90ff-8f9b077d51fe</b:FlowGuid><b:Id>288</b:Id><b:InteractionKey>004e6504-6c56-4966-968f-c699ba39351f:372f04fd-f8e7-4f92-90ff-8f9b077d51fe:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:13:51.4067045-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Persistent Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Evidence Gateway API' could be a subject to a persistent cross-site scripting attack because it does not sanitize data store 'Off Chain Storage' inputs and output.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>There's no HTML rendering or browser DOM execution context</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Gateway - Storage Flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>004e6504-6c56-4966-968f-c699ba39351f</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>T13.1004e6504-6c56-4966-968f-c699ba39351f372f04fd-f8e7-4f92-90ff-8f9b077d51fef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>372f04fd-f8e7-4f92-90ff-8f9b077d51fe</b:FlowGuid><b:Id>287</b:Id><b:InteractionKey>004e6504-6c56-4966-968f-c699ba39351f:372f04fd-f8e7-4f92-90ff-8f9b077d51fe:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:13:44.5694947-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Cross Site Scripting</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Tampering</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Tampering is the act of altering the bits. Tampering with a process involves changing bits in the running process. Similarly, Tampering with a data flow involves changing bits on the wire or between two running processes.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>The web server 'Evidence Gateway API' could be a subject to a cross-site scripting attack because it does not sanitize untrusted input.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>There's no HTML rendering or browser DOM execution context</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Gateway - Storage Flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>004e6504-6c56-4966-968f-c699ba39351f</b:SourceGuid><b:State>NotApplicable</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>T13.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7004e6504-6c56-4966-968f-c699ba39351f372f04fd-f8e7-4f92-90ff-8f9b077d51fef1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>372f04fd-f8e7-4f92-90ff-8f9b077d51fe</b:FlowGuid><b:Id>286</b:Id><b:InteractionKey>004e6504-6c56-4966-968f-c699ba39351f:372f04fd-f8e7-4f92-90ff-8f9b077d51fe:f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-21T10:18:46.62804-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of Source Data Store Off Chain Storage</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Off Chain Storage may be spoofed by an attacker and this may lead to incorrect data delivered to Evidence Gateway API. Consider using a standard authentication mechanism to identify the source data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Incorrect data delivery would not be a problem as the information is cross-validated with data store on the Fabric blockchain.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>Gateway - Storage Flow</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>004e6504-6c56-4966-968f-c699ba39351f</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f1ac5d0c-3ac6-40b9-beca-e1fb4f6d47f5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E52e28b743-dcab-4fb7-8a07-50d24d00b023692ca193-0dc2-478e-93f2-64f5f64281b46c1a9dad-8b8d-49aa-804c-bb28af9cefc5</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>692ca193-0dc2-478e-93f2-64f5f64281b4</b:FlowGuid><b:Id>284</b:Id><b:InteractionKey>2e28b743-dcab-4fb7-8a07-50d24d00b023:692ca193-0dc2-478e-93f2-64f5f64281b4:6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:10:43.3551748-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Issuer/Verifier Cloud Agent may be able to impersonate the context of Holder Cloud Agent in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by AnonCreds Link Secret binding and DIDComm asymmetric key signatures, which prevent credential replay and impersonation.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>DIDComm</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E56c1a9dad-8b8d-49aa-804c-bb28af9cefc511c117b3-8605-44d5-9adb-6f219003ec6e2e28b743-dcab-4fb7-8a07-50d24d00b023</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy>DESKTOP-U26BJ62\T-Gamer</b:ChangedBy><b:DrawingSurfaceGuid>ad851ae6-9c2a-4bf7-bde3-f633d4910b68</b:DrawingSurfaceGuid><b:FlowGuid>11c117b3-8605-44d5-9adb-6f219003ec6e</b:FlowGuid><b:Id>285</b:Id><b:InteractionKey>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5:11c117b3-8605-44d5-9adb-6f219003ec6e:2e28b743-dcab-4fb7-8a07-50d24d00b023</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>2026-10-20T14:10:40.6045621-03:00</b:ModifiedAt><b:Priority>Low</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Holder Cloud Agent may be able to impersonate the context of Issuer/Verifier Cloud Agent in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>StateInformation</a:Key><a:Value>Mitigated by AnonCreds Link Secret binding and DIDComm asymmetric key signatures, which prevent credential replay and impersonation.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>DIDComm</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>Priority</a:Key><a:Value>Low</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>6c1a9dad-8b8d-49aa-804c-bb28af9cefc5</b:SourceGuid><b:State>Mitigated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>2e28b743-dcab-4fb7-8a07-50d24d00b023</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB></ThreatInstances><ThreatGenerationEnabled>true</ThreatGenerationEnabled><Validations xmlns:a="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"/><Version>4.3</Version><KnowledgeBase z:Id="i44" xmlns:a="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase" xmlns:z="http://schemas.microsoft.com/2003/10/Serialization/"><a:GenericElements><a:ElementType><a:IsExtension>false</a:IsExtension><a:Attributes><a:Attribute><a:IsExtension>false</a:IsExtension><a:AttributeValues xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.Interfaces"><b:Value>Not Selected</b:Value><b:Value>Managed</b:V